{
  "name": "agent-office",
  "version": "1.3.0",
  "description": "Your personal AI agents, alive in a tiny pixel-art office. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "UzRustamBek",
  "homepage": "https://github.com/UzRustamBek/agent-office#readme",
  "repository": {
